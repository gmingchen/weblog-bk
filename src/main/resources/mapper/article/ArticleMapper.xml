<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.slipper.weblog.modules.article.mapper.ArticleMapper">

    <resultMap id="ArticleInfoMap" type="com.slipper.weblog.modules.article.model.dto.ArticleInfoVO">
        <id property="id" column="id" />
        <result property="title" column="title" />
        <result property="slug" column="slug" />
        <result property="cover" column="cover" />
        <result property="content" column="content" />
        <result property="excerpt" column="excerpt" />
        <result property="isFeatured" column="is_featured" />
        <result property="status" column="status" />
        <result property="viewCount" column="view_count" />
        <result property="commentCount" column="comment_count" />
        <result property="likeCount" column="like_count" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
        <collection property="categoryList" ofType="com.slipper.weblog.modules.category.model.vo.CategoryBaseVO">
            <id property="id" column="category_id"/>
            <result property="name" column="category_name"/>
        </collection>
        <collection property="tagList" ofType="com.slipper.weblog.modules.tag.model.vo.TagBaseVO">
            <id property="id" column="tag_id"/>
            <result property="name" column="tag_name"/>
        </collection>
        <collection property="columnList" ofType="com.slipper.weblog.modules.column.model.vo.ColumnBaseVO">
            <id property="id" column="column_id"/>
            <result property="name" column="column_name"/>
        </collection>
    </resultMap>

    <select id="queryInfo" resultMap="ArticleInfoMap">
        SELECT a.id, a.title, a.slug, a.cover, a.content, a.excerpt, a.is_featured, a.status,
               a.view_count, a.comment_count, a.like_count, a.created_at, a.updated_at,
               ca.id AS category_id, ca.name AS category_name,
               ta.id AS tag_id, ta.name AS tag_name, co.id AS column_id, co.name AS column_name
        FROM article AS a
                 LEFT JOIN article__category AS aca ON aca.article_id = a.id
                 LEFT JOIN category AS ca ON ca.id = aca.category_id AND ca.deleted = 0
                 LEFT JOIN article__tag AS ata ON ata.article_id = a.id
                 LEFT JOIN tag AS ta ON ta.id = ata.tag_id AND ta.deleted = 0
                 LEFT JOIN article__column AS aco ON aco.article_id = a.id
                 LEFT JOIN `column` AS co ON co.id = aco.column_id AND co.deleted = 0
        WHERE a.id = #{ id }
          AND a.deleted = 0
    </select>
</mapper>
